rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidWorkspace(data, userId) {
      return data.keys().hasAll([
          'userId', 'name', 'hostName', 'environment', 'repository',
          'branch', 'status', 'lastHeartbeatAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'name', 'hostName', 'environment', 'repository',
          'branch', 'status', 'lastHeartbeatAt', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 100 &&
        data.environment is string && data.environment in ['LOCAL_WORKSTATION', 'CLOUD_SANDBOX'] &&
        data.repository is string && data.repository.size() <= 160 &&
        data.branch is string && data.branch.size() <= 80 &&
        data.status is string && data.status in ['ONLINE', 'IDLE', 'OFFLINE'] &&
        isValidTimestamp(data.lastHeartbeatAt) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAgentTask(data, userId) {
      return data.keys().hasAll([
          'userId', 'workspaceId', 'title', 'objective', 'status',
          'currentPhase', 'activeTool', 'progressPercent', 'summary',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'workspaceId', 'title', 'objective', 'status',
          'currentPhase', 'activeTool', 'progressPercent', 'summary',
          'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == userId &&
        isValidId(data.workspaceId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.objective is string && data.objective.size() >= 1 && data.objective.size() <= 2000 &&
        data.status is string && data.status in ['RUNNING', 'PAUSED', 'AWAITING_APPROVAL', 'COMPLETED', 'FAILED', 'STOPPED'] &&
        data.currentPhase is string && data.currentPhase.size() >= 1 && data.currentPhase.size() <= 100 &&
        data.activeTool is string && data.activeTool in ['EDITOR', 'TERMINAL', 'BROWSER', 'PLANNER'] &&
        data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100 &&
        data.summary is string && data.summary.size() <= 1000 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidApprovalRequest(data, userId) {
      return data.keys().hasAll([
          'userId', 'workspaceId', 'taskId', 'type', 'title',
          'description', 'payload', 'riskLevel', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'workspaceId', 'taskId', 'type', 'title',
          'description', 'payload', 'riskLevel', 'status',
          'decisionNote', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == userId &&
        isValidId(data.workspaceId) &&
        isValidId(data.taskId) &&
        data.type is string && data.type in ['PLAN', 'CODE_DIFF', 'TERMINAL_COMMAND'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.description is string && data.description.size() <= 1000 &&
        data.payload is string && data.payload.size() >= 1 && data.payload.size() <= 20000 &&
        data.riskLevel is string && data.riskLevel in ['LOW', 'MEDIUM', 'HIGH'] &&
        data.status is string && data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
        (!('decisionNote' in data) || data.decisionNote == null || (data.decisionNote is string && data.decisionNote.size() <= 1000)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidControlCommand(data, userId) {
      return data.keys().hasAll([
          'userId', 'workspaceId', 'taskId', 'action', 'payload',
          'deliveryStatus', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'workspaceId', 'taskId', 'action', 'payload',
          'deliveryStatus', 'createdAt', 'updatedAt'
        ]) &&
        data.userId is string && data.userId == userId &&
        isValidId(data.workspaceId) &&
        isValidId(data.taskId) &&
        data.action is string && data.action in [
          'PAUSE', 'RESUME', 'STOP', 'STEER_PROMPT',
          'APPROVE_ARTIFACT', 'REJECT_ARTIFACT', 'START_TASK'
        ] &&
        data.payload is string && data.payload.size() <= 4000 &&
        data.deliveryStatus is string && data.deliveryStatus in ['QUEUED', 'ACKNOWLEDGED', 'EXECUTED'] &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidLogEntry(data, userId) {
      return data.keys().hasAll([
          'userId', 'taskId', 'level', 'source', 'message', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId', 'taskId', 'level', 'source', 'message', 'createdAt'
        ]) &&
        data.userId is string && data.userId == userId &&
        isValidId(data.taskId) &&
        data.level is string && data.level in ['INFO', 'STEP', 'WARN', 'ERROR', 'COMMAND'] &&
        data.source is string && data.source in ['AGENT', 'TERMINAL', 'BROWSER', 'SYSTEM'] &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 4000 &&
        isValidTimestamp(data.createdAt);
    }

    // --- USER-SCOPED COLLECTIONS ---
    match /users/{userId} {

      // 1. Workspaces
      match /workspaces/{workspaceId} {
        allow get: if isOwner(userId) && isValidId(workspaceId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(workspaceId) &&
          isValidWorkspace(incoming(), userId);

        allow update: if isOwner(userId) &&
          isValidId(workspaceId) &&
          isValidWorkspace(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          (
            // Action: Heartbeat & live status refresh
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'branch', 'repository', 'lastHeartbeatAt', 'updatedAt'
            ]) ||
            // Action: Workspace configuration update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'hostName', 'environment', 'repository', 'branch', 'status', 'updatedAt'
            ])
          );

        allow delete: if isOwner(userId) && isValidId(workspaceId);
      }

      // 2. Autonomous Agent Tasks
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(taskId) &&
          isValidAgentTask(incoming(), userId) &&
          existsAfter(/databases/$(database)/documents/users/$(userId)/workspaces/$(incoming().workspaceId));

        allow update: if isOwner(userId) &&
          isValidId(taskId) &&
          isValidAgentTask(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().createdAt == existing().createdAt &&
          // Terminal state locking: sealed tasks cannot be mutated
          !(existing().status in ['COMPLETED', 'STOPPED']) &&
          (
            // Action: Lifecycle transition & progress telemetry update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'currentPhase', 'activeTool', 'progressPercent', 'summary', 'updatedAt'
            ])
          );

        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // 3. Human-in-the-Loop Approval Requests
      match /approvals/{approvalId} {
        allow get: if isOwner(userId) && isValidId(approvalId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(approvalId) &&
          isValidApprovalRequest(incoming(), userId) &&
          incoming().status == 'PENDING' &&
          existsAfter(/databases/$(database)/documents/users/$(userId)/tasks/$(incoming().taskId));

        allow update: if isOwner(userId) &&
          isValidId(approvalId) &&
          isValidApprovalRequest(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().taskId == existing().taskId &&
          incoming().type == existing().type &&
          incoming().title == existing().title &&
          incoming().description == existing().description &&
          incoming().payload == existing().payload &&
          incoming().riskLevel == existing().riskLevel &&
          incoming().createdAt == existing().createdAt &&
          // Terminal state locking: only PENDING gates can be decided
          existing().status == 'PENDING' &&
          incoming().status in ['APPROVED', 'REJECTED'] &&
          (
            // Action: Human approval or rejection decision
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'decisionNote', 'updatedAt'
            ])
          );

        allow delete: if isOwner(userId) && isValidId(approvalId);
      }

      // 4. Remote Control & Steering Command Queue
      match /commands/{commandId} {
        allow get: if isOwner(userId) && isValidId(commandId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(commandId) &&
          isValidControlCommand(incoming(), userId) &&
          incoming().deliveryStatus == 'QUEUED' &&
          existsAfter(/databases/$(database)/documents/users/$(userId)/tasks/$(incoming().taskId));

        allow update: if isOwner(userId) &&
          isValidId(commandId) &&
          isValidControlCommand(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().taskId == existing().taskId &&
          incoming().action == existing().action &&
          incoming().payload == existing().payload &&
          incoming().createdAt == existing().createdAt &&
          // Terminal state locking: executed commands are immutable
          existing().deliveryStatus != 'EXECUTED' &&
          (
            // Action: Relay bridge acknowledgement or execution update
            incoming().diff(existing()).affectedKeys().hasOnly([
              'deliveryStatus', 'updatedAt'
            ])
          );

        allow delete: if isOwner(userId) && isValidId(commandId);
      }

      // 5. Append-Only Task Timeline & Terminal Logs
      match /logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
          isValidId(logId) &&
          isValidLogEntry(incoming(), userId) &&
          existsAfter(/databases/$(database)/documents/users/$(userId)/tasks/$(incoming().taskId));

        // Logs are strictly append-only
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}
